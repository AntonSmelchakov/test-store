{
  "name": "test-store",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "project:init": "pnpm start:db && pnpm init:migration && pnpm project:run",
    "project:run": "concurrently \"pnpm start:db\" \"pnpm start:backend\" \"pnpm start:frontend\"",
    "start:db": "pnpm -C backend run db:start",
    "init:migration": "pnpm -C backend run migration:run",
    "start:backend": "wait-on tcp:localhost:3306 && pnpm -C backend run start",
    "start:frontend": "pnpm -C frontend run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "dependencies": {
    "concurrently": "^10.0.5",
    "wait-on": "^9.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
